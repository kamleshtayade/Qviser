# Dhan API credentials (copy this file to .env and fill in real values)
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Access token auto-renewal (Dhan Web tokens last 24h and can only be renewed while active).
# At startup, the token is renewed if it has fewer than this many hours left (0-24].
DHAN_TOKEN_RENEW_BEFORE_HOURS=12
# Set to false to turn auto-renewal off.
DHAN_TOKEN_AUTO_RENEW=true
